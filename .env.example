# Supabase — obrigatórios. Sem eles o app para na inicialização com erro claro.
# Pegue em: Supabase → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# PostHog — opcional. Sem a key, toda a instrumentação vira no-op silencioso.
# Necessário pra medir o funil de ativação do beta (onde as pessoas desistem).
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Suporte — opcional. Use apenas dígitos com DDI + DDD (ex.: 5511999999999).
# Se omitido, o app usa o número público padrão do Studoo.
VITE_SUPPORT_WHATSAPP=5549999256170

# Stripe Billing — apenas para documentação local.
# NÃO crie versões VITE_* dessas variáveis: elas são secrets de Edge Functions.
# Configure no Supabase com `supabase secrets set ...`.
APP_BASE_URL=https://studoo.com.br
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MENSAL=
STRIPE_PRICE_ID_ANUAL=
